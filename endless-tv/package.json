{
  "name": "endless-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Endless TV: a public TV guide whose channels are generated by MiniMax H3 on rented GPUs. The GPU boxes upload their clips here, so they can be thrown away.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "jest --coverage",
    "check:railway": "tsc -p tsconfig.railway.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "jest": "^30.0.5",
    "railway": "^3.17.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "server/**/*.js",
      "public/js/live.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
