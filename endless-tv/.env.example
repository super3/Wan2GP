# Copy to .env for local runs (npm start reads the environment; Railway sets these in the service's Variables).
PORT=3000
# The token GPU boxes send to upload (Authorization: Bearer ...). Without it, uploads are off. Long and random:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INGEST_TOKEN=
# Where uploads are kept. On Railway the volume's RAILWAY_VOLUME_MOUNT_PATH is used; locally ./data.
DATA_DIR=
# Largest upload, in MB.
MAX_UPLOAD_MB=300
# Clips kept per channel (oldest dropped first); 0 keeps them all.
KEEP_CLIPS=0
# The invite the header's "Join our Discord" button opens (https only); without it there is no button.
DISCORD_URL=
