*.html
# ...but the endpoint tester is source, not a stray render. A bare *.html
# makes `git add -A` skip it with no error, exactly as the bare `.*` on line 1
# once ate .dockerignore and the CI workflow.
!runpod_worker/webdemo/*.html
!runpod_worker/gateway/static/*.html
!plugins/motion_designer/assets/motion_designer_iframe_template.html
